+    uint8_t settle_seen;
+    uint32_t brake_ms;
+    uint32_t settle_ms;
+    uint32_t manual_duration;
+    uint32_t run_duration;
+    uint32_t switch_ms;
+    uint32_t start_ms;
+    unsigned manual_speed;
+    uint8_t switching;
+    float targets[2];
+    uint8_t leg;
+    uint8_t edge_seen;
+    uint32_t edge_ms;
+    uint32_t elapsed_ms;
+    float leg_start;
+    float start_heading;
+} CarRouteState;
+
+typedef struct {
+    Wheel items[2];
+} CarWheelState;
+
+typedef struct {
+    CommandInput inputs[LAB_UART_COUNT];
+} CarCommandState;
+
+typedef struct {
+    ADC_HandleTypeDef * adc;
+    uint8_t valid;
