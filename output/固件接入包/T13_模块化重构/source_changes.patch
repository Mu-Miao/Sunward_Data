+    uint8_t invalid_seen;
+    uint32_t center_ms;
+    uint32_t sample_ms;
+    uint32_t invalid_ms;
+    float error;
+    float diff;
+} CarLineState;
+
+typedef struct {
+    Motion motion;
+    float distance_mm[2];
+    float base;
+    float goal;
+    float cruise;
+    float slow;
+    uint16_t distance_count[2];
