+/* Expected mileage plus a stable edge gates every transition.
+   Mid-arc loss still brakes immediately; white straights use heading control. */
+static void task2_update(uint32_t now)
+{
+    if (motion != MOVE_TASK2 || state != RUNNING) return;
+    float travelled = (distance_mm[LEFT] + distance_mm[RIGHT]) * 0.5f;
+    float progress = travelled - task2_leg_start;
+    int arc = task2_arc();
+    float length = arc ? DPT_TASK2_ARC_MM : DPT_TASK2_STRAIGHT_MM;
+    float window = arc ? DPT_TASK2_EXIT_WINDOW_MM : DPT_TASK2_ENTRY_WINDOW_MM;
+    int expected_edge;
+    if (!arc) expected_edge = line_valid;
+    else {
+        float end_heading = task2_leg == 1U ? wrap_degrees(task2_start_heading + 180.0f) : task2_start_heading;
+        float error = wrap_degrees(end_heading - yaw_angle);
+        expected_edge = line_count == 0U && error >= -DPT_TASK2_END_ANGLE_DEG && error <= DPT_TASK2_END_ANGLE_DEG;
+    }
+    if (progress >= length - window && progress <= length + window && expected_edge) {
+        if (!task2_edge_seen) { task2_edge_seen = 1U; task2_edge_ms = now; }
+        if (arc) {
+            drive(0, 0); /* Exit-white debounce is stationary, never an open-loop search. */
+            clear_controllers();
+            targets[LEFT] = targets[RIGHT] = 0.0f;
+        }
+        if ((uint32_t)(now - task2_edge_ms) >= DPT_TASK2_EDGE_MS) {
+            task2_edge_seen = line_invalid_seen = 0U;
+            if (task2_leg == 3U) { stop(BRAKING, '-'); return; }
+            ++task2_leg;
+            task2_leg_start = travelled;
+            clear_controllers();
+            signal_ms = now;
+            signal_set(1); /* B, C, D; signalling does not pause the route. */
+            distance_cruise = task2_arc() ? DPT_LINE_CRUISE_MMPS : DPT_TASK2_STRAIGHT_MMPS;
+            if (!task2_arc()) {
+                yaw_reference = wrap_degrees(task2_start_heading + 180.0f);
+                yaw_error = wrap_degrees(yaw_reference - yaw_angle);
+                yaw_diff = DPT_HEADING_GAIN * yaw_error;
+                if (yaw_diff > DPT_HEADING_MAX_DIFF) yaw_diff = DPT_HEADING_MAX_DIFF;
+                if (yaw_diff < -DPT_HEADING_MAX_DIFF) yaw_diff = -DPT_HEADING_MAX_DIFF;
+            }
+            return;
+        }
+    } else task2_edge_seen = 0U;
+    if (progress > length + window)
+        stop(arc ? LINE_BAD : LINE_LOST, '-');
+}
